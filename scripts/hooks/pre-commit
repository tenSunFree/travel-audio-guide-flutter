#!/usr/bin/env bash
# scripts/pre-commit
#
# Checks before every commit:
#   1. dart format check — lib/test/integration_test/pigeons (same scope as scripts/check.sh)
#      does NOT auto-fix; tells you exactly what to run
#   2. flutter analyze — static analysis (catches lint issues like
#      unnecessary_underscores before they reach pre-push)
#   3. Secret scan on staged changes
#        - gitleaks installed  -> gitleaks protect --staged --verbose
#        - gitleaks NOT installed -> warn + fallback to built-in regex scanner
#
# Install: bash scripts/setup-hooks.sh
# Bypass (not recommended): git commit --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
source "scripts/_fvm.sh"

echo ""
echo "pre-commit: running checks..."

# ============================================================
# 1. dart format check (same scope as scripts/check.sh: lib test integration_test pigeons)
# ============================================================
echo ""
echo "==> dart format check"

if $DART_CMD format --output=none --set-exit-if-changed lib test integration_test pigeons; then
    echo "Passed: dart format check"
else
    echo ""
    echo "Unformatted file found, commit aborted. Please continue:"
    echo "bash scripts/format.sh"
    echo "git add -u"
    echo "git commit"
    exit 1
fi

# ============================================================
# 2. flutter analyze (static analysis)
# ============================================================
echo ""
echo "==> flutter analyze"

if $FLUTTER_CMD analyze; then
    echo "Passed: flutter analyze"
else
    echo ""
    echo "Analyze issues found, commit aborted. Please fix them before committing:"
    echo "fvm flutter analyze"
    exit 1
fi

# ============================================================
# 3. secret scan (staged changes)
# ============================================================
echo ""
echo "==> secret scan (staged changes)"

if command -v gitleaks >/dev/null 2>&1; then
    echo "Gitleaks detected. Using gitleaks to scan staged content..."
    echo ""

    if gitleaks protect --staged --verbose; then
        echo ""
        echo "Passed: gitleaks scan"
    else
        GITLEAKS_STATUS=$?
        echo ""
        echo "gitleaks detected potentially confidential content (exit code: $GITLEAKS_STATUS), commit aborted."
        echo "If it is confirmed to be a false positive, you can create an .gitleaks.toml file to set an allowlist."
        echo "Or use 'git commit --no-verify' to skip it (not recommended)."
        exit 1
    fi
else
    echo "gitleaks not detected, using the built-in regex fallback scanner instead."
    echo "It is recommended to install gitleaks for a more complete scan (entropy analysis + complete rule base):"
    echo "https://github.com/gitleaks/gitleaks#installing"
    echo ""

    # Regular expressions for common key/credential formats (use double quotes to avoid single quotes causing error)
    SECRET_PATTERN="AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|gh[pousr]_[0-9A-Za-z]{20,}|github_pat_[0-9A-Za-z_]{20,}|xox[baprs]-[0-9A-Za-z-]{10,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[0-9A-Za-z]{20,}|-----BEGIN (RSA|DSA|EC|OPENSSH|PRIVATE) KEY-----|(password|passwd|secret|token|api[_-]?key)[[:space:]]*[:=][[:space:]]*[\"'][^\"']{6,}[\"']"

    STAGED_ALL_FILES=()
    while IFS= read -r -d '' file; do
        STAGED_ALL_FILES+=("$file")
    done < <(git diff --cached --name-only --diff-filter=ACM -z)

    FOUND_SECRET=0
    for f in "${STAGED_ALL_FILES[@]}"; do
        [ -f "$f" ] || continue

        # Skip binary files
        if ! git diff --cached -- "$f" | grep -Iq .; then
            continue
        fi

        # Only view the "New" lines (starting with +) to avoid misjudging older content and to prevent deletion of confidential information from being blocked.
        MATCHES=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -vE '^\+\+\+' \
            | grep -EiA0 -- "$SECRET_PATTERN")

        if [ -n "$MATCHES" ]; then
            echo ""
            echo "Possible confidential content: $f"
            echo "$MATCHES" | sed 's/^/    /'
            FOUND_SECRET=1
        fi

        # Blacklist of Additional File Names (Common Voucher Files)
        case "$f" in
            *.env|*.env.*|*.pem|*.p12|*.jks|*.keystore|*id_rsa*|*id_ed25519*)
                echo ""
                echo "Submitting a file that looks like a confidential/credential file: $f"
                FOUND_SECRET=1
                ;;
        esac
    done

    if [ "$FOUND_SECRET" -ne 0 ]; then
        echo ""
        echo "The fallback scanner detected potentially confidential content, and the commit was aborted."
        echo "If it is determined to be a false positive, you can use 'git commit --no-verify' to skip it (not recommended)."
        exit 1
    fi

    echo "Passed: fallback secret scan"
fi

echo ""
echo "pre-commit: All checks passed."
exit 0
